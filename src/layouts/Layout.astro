---
export interface Props {
  title: string;
  description: string;
  ogDescription?: string;
}

const { title, description, ogDescription = description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#2F4A3A">

<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:locale" content="en">

<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%232F4A3A'/><text x='16' y='23' font-family='Georgia,serif' font-size='20' fill='%23F5F0E6' text-anchor='middle'>P</text></svg>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/styles.css">

<!-- Marks that JS is running, so reveal animations only hide content when they can also show it again.
     is:inline: must run synchronously before first paint, not as a deferred module. -->
<script is:inline>document.documentElement.className += " js";</script>
</head>

<body data-phone="94772813748" data-house="Pahan Guest">
  <slot />

  <!-- is:inline: this is plain vanilla JS meant to run exactly as authored,
       not bundled/transformed by Vite — see public/assets/js/app.js. -->
  <script is:inline src="/assets/js/app.js"></script>
</body>
</html>
